# --- Front-end (Vercel → Environment Variables) ------------------------------
# URL et clé publique (anon) du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Edge Functions (supabase secrets set KEY=VALUE) --------------------------
# Clé secrète Stripe (mode test : sk_test_..., prod : sk_live_...)
# STRIPE_SECRET_KEY=sk_test_...
# Secret de signature du webhook (Dashboard Stripe → Webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Clé API Resend pour les emails transactionnels
# RESEND_API_KEY=re_...
# Expéditeur des emails (domaine vérifié chez Resend : DKIM/SPF/DMARC)
# EMAIL_FROM="Lokin Energy <commandes@lokin-energy.fr>"
# URL publique du site (redirections Stripe)
# SITE_URL=https://lokin-energy.fr
# Origine autorisée pour le CORS des fonctions
# ALLOWED_ORIGIN=https://lokin-energy.fr
